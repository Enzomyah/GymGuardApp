{
  "expo": {
    "name": "GymGuard",
    "slug": "GymGuard",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/Appicon.png",
    "scheme": "gymguard",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.javenad.gymguard",
      "adaptiveIcon": {
        "backgroundColor": "#101010",
        "foregroundImage": "./assets/images/Appicon.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 5
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#101010",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "react-native-compressor",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app needs access to your gallery for profile pictures.",
          "cameraPermission": "The app needs access to your camera for profile pictures."
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "09d58246-6523-44ac-bac5-e670b185198f"
      }
    }
  }
}
